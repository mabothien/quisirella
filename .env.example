# Anthropic API key for the LangGraph agents (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Model used by supervisor and subagents
QUISIRELLA_MODEL=claude-sonnet-4-6

# Meta Ads — System User token (Cursor dùng .cursor/mcp.json, Python đọc .env)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_...

# Google Sheets - financial data
# Share the sheet with your service account email, then set the spreadsheet ID here
GOOGLE_SHEET_ID=your-spreadsheet-id
# Path to the service account JSON key file
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# Ranges (A1 notation) that contain the financial data, comma-separated
GOOGLE_SHEET_RANGES=DoanhThu!A:Z,ChiPhi!A:Z
