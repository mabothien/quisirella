# Google Sheets — bảng giá quisirella
# Share Sheet Viewer cho service account (client_email trong credentials/service_account.json)
# Cell mapping: config/finance_sheet.yaml (tab BÁO GIÁ 2026)
GOOGLE_SHEET_ID=your-spreadsheet-id
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# Fetch finance data:
#   python -m quisirella fetch-finance --month 2026-06

# Hugging Face Hub token — tải model nhanh hơn, không warning unauthenticated
# Tạo tại https://huggingface.co/settings/tokens (read)
HF_TOKEN=

# Phase B/C — local embeddings + hybrid RAG (no OpenAI)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RAG_SCORE_FLOOR=0.35
RAG_AMBIGUOUS_MARGIN=0.05
INTENT_SCORE_FLOOR=0.3
RAG_HYBRID_FETCH_K=30
RAG_HIGH_CONFIDENCE=0.82

# Optional LLM for headless CRAG rewrite (default: none — Cursor agent handles rewrite)
RAG_LLM_PROVIDER=none
# RAG_LLM_PROVIDER=ollama
# RAG_LLM_PROVIDER=anthropic
# RAG_LLM_MODEL=
# OLLAMA_BASE_URL=http://localhost:11434

# Index commands (sau cài pip install -e .):
#   python -m quisirella index-intents
#   python -m quisirella index-knowledge
#   python -m quisirella index-knowledge --incremental
#   python -m quisirella route-intent "loi nhuan thang 7"
#   python -m quisirella search-knowledge "chi phi tin nhan pheu"
#   python -m quisirella search-knowledge "..." --retry
#   python -m quisirella eval-rag
#   pytest tests/test_rag_retrieval.py -q
